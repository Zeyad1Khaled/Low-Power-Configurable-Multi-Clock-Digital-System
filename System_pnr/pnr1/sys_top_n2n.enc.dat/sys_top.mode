setAnalysisMode -checkType setup -clkSrcPath true -clockPropagation sdcControl -cts postCTS -skew true -virtualIPO false
setTrialRouteMode -handlePreroute true -keepMarkedOptRoutes true
setOptMode -drcMargin 0 -effort high -fixDrc true -route noIncr -rPlace true -setupTargetSlack 0
setExtractRCMode  -engine detail -coupled false -force true -viaCap true -nrNetInMemory 100016 -minNetTermNrToBeInMem 50
setDelayCalMode -engine default
setNanoRouteMode -quiet -drouteAntennaFactor 1.000000
setNanoRouteMode -quiet -droutePostRouteMinimizeViaCount false
setNanoRouteMode -quiet -droutePostRouteSpreadWire false
setNanoRouteMode -quiet -droutePostRouteSwapVia "none"
setNanoRouteMode -quiet -droutePostRouteWidenWire "none"
setNanoRouteMode -quiet -drouteStartIteration 0
setNanoRouteMode -quiet -envNumberWarningLimit 20
setNanoRouteMode -quiet -routeSiEffort "min"
setNanoRouteMode -quiet -routeWithEco true

setPlaceMode -ignoreScan true -timingDriven true -useNP true -WLHighEffort false
setImportMode -config true -keepEmptyModule true -treatUndefinedCellAsBbox false -useLefDef56 true
