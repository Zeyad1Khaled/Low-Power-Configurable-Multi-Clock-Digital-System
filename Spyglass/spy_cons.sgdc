
current_design sys_top

####################################################################################
           #########################################################
                  #### Section 1 : Clock Definition ####
           #########################################################
#################################################################################### 

clock -name REF_CLK -domain REF_DOMAIN -period 10 -waveform {0 5}
clock -name UART_CLK -domain UART_DOMAIN -period 271.267 -waveform {0 135.6335}

#clock -name TX_CLK -period 8680.5555552 -edge {0 4340.2777776} -domain UART_DOMAIN
#Prescale=32
#clock -name RX_CLK -period 542.535  -edge {0 135.6336806}  -domain UART_DOMAIN
#Prescale=16

#clock -name GATED_CLK -period 20 -edge {0 10} -domain REF_DOMAIN

clock -tag VIRTUAL_RST_CLK -period 20 -edge {0 10} -domain VIRTUAL_RST_DOMAIN

clock -name tx_clk -period 8680.5555552 -edge {0 4340.2777776} -domain UART_DOMAIN
#Prescale=32
clock -name rx_clk -period 271.2673611  -edge {0 135.6336806}  -domain UART_DOMAIN
#Prescale=16
#
####################################################################################
           #########################################################
                  #### Section 2 : Reset Definition ####
           #########################################################
####################################################################################

reset -name RST_N -value 0 -async 

####################################################################################
           #########################################################
             #### Section 3 : set input/output clock domains  ####
           #########################################################
####################################################################################

abstract_port -ports UART_RX_IN     -clock UART_CLK
    
abstract_port -ports REF_CLK     -clock REF_CLK    

abstract_port -ports UART_TX_O     -clock UART_CLK   
 
abstract_port -ports RST_N           -clock VIRTUAL_RST_CL
set_case_analysis -name sys_top.test_mode -value 0
####################################################################################
           #########################################################
             #### Section 4 : DATA/RESET Synchronizers  ####
           #########################################################
####################################################################################
#set_case_analysis -name sys_top.Regfile_u.REG2 -value 1
#set_case_analysis -name sys_top.Regfile_u.REG3 -value 1
set_case_analysis -name sys_top.Regfile_u.REG2 -value 01000001
set_case_analysis -name sys_top.Regfile_u.REG3 -value 00100000
quasi_static -name sys_top.Regfile_u.REG2
cdc_attribute -unrelated  {sys_top.FIFO_u.U5.RD_PTR_GRAY sys_top.UART_TX_RX.RX_OUT_V}
fifo -memory "sys_top.FIFO_u.U1.mem"
fifo -memory "FIFO_u.U1" \
       -rd_data "FIFO_u.RD_DATA" \
       -wr_data "FIFO_u.WR_DATA" \
       

gray_signals -name {FIFO_u.w_ptr FIFO_u.r_ptr}
quasi_static -name sys_top.Regfile_u.REG3
